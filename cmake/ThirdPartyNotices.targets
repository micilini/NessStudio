<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../licenses/third-party/*">
      <Link>Licenses/ThirdParty/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
