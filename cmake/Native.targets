<Project>
  <PropertyGroup>
    <NessRepositoryRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..'))</NessRepositoryRoot>
    <NessNativeBuildDirectory Condition="'$(NessNativeBuildDirectory)' == ''">$(NessRepositoryRoot)/.out/native/windows-x64/$(Configuration)</NessNativeBuildDirectory>
    <NessPowerShellExecutable Condition="'$(NessPowerShellExecutable)' == ''">$(SystemRoot)/System32/WindowsPowerShell/v1.0/powershell.exe</NessPowerShellExecutable>
  </PropertyGroup>
  <Target Name="BuildNessNative" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems" Condition="'$(DesignTimeBuild)' != 'true' and '$(NessNativeStaged)' != 'true'">
    <PropertyGroup>
      <NessNativeStage>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'native-runtime'))</NessNativeStage>
    </PropertyGroup>
    <Exec Command="&quot;$(NessPowerShellExecutable)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(NessRepositoryRoot)/cmake/Build-Native.ps1&quot; -Configuration &quot;$(Configuration)&quot; -NativeBuildDirectory &quot;$(NessNativeBuildDirectory)&quot; -StageDirectory &quot;$(NessNativeStage)&quot;" />
    <ItemGroup>
      <_NessNativeRuntime Include="$(NessNativeStage)/*" />
      <Content Include="@(_NessNativeRuntime)">
        <Link>%(_NessNativeRuntime.Filename)%(_NessNativeRuntime.Extension)</Link>
        <TargetPath>%(_NessNativeRuntime.Filename)%(_NessNativeRuntime.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </Content>
      <FileWrites Include="@(_NessNativeRuntime)" />
    </ItemGroup>
    <PropertyGroup><NessNativeStaged>true</NessNativeStaged></PropertyGroup>
  </Target>
</Project>
