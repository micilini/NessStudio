<Window x:Class="NessStudio.View.SavingRecordingScreen.SavingRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Saving Recording"
        Width="420"
        Height="190"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="190"
        MaxHeight="190"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="#1C1F21"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <materialDesign:Card Background="#23272A"
                         UniformCornerRadius="14"
                         Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Image Source="/Assets/Images/logo-nessstudio.png"
                       Width="28"
                       Height="28"
                       Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           FontFamily="Arial"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#CCD5D7"/>
            </StackPanel>
            <TextBlock Grid.Row="2"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontFamily="Arial"
                       FontSize="14"
                       Foreground="#AAB4B8"/>
            <ProgressBar Grid.Row="4"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Percent}"
                         IsIndeterminate="{Binding IsIndeterminate}"/>
            <DockPanel Grid.Row="6">
                <TextBlock Text="{Binding StepText}"
                           FontFamily="Arial"
                           FontSize="12"
                           Foreground="#8A9499"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}"
                           FontFamily="Arial"
                           FontSize="12"
                           Foreground="#8A9499"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Grid>
    </materialDesign:Card>
</Window>