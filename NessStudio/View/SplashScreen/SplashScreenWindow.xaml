<Window x:Class="NessStudio.View.SplashScreen.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NessStudio.View.SplashScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="{x:Null}"
        Title="SplashScreenWindow"
        Height="712"
        Width="950"
        ContentRendered="Window_ContentRendered">

    <Border x:Name="SplashWindowBorder"
            Width="900"
            Height="662"
            CornerRadius="22"
            Background="#171A1D"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Grid x:Name="SplashWindowClipGrid"
              ClipToBounds="True">
            <Grid.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Width="{Binding ActualWidth, ElementName=SplashWindowClipGrid}"
                                Height="{Binding ActualHeight, ElementName=SplashWindowClipGrid}"
                                CornerRadius="22"
                                Background="Black" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.OpacityMask>

            <Grid.Background>
                <RadialGradientBrush Center="0.18,0.08"
                                     GradientOrigin="0.18,0.08"
                                     RadiusX="1.05"
                                     RadiusY="1.05">
                    <GradientStop Color="#2A2022" Offset="0" />
                    <GradientStop Color="#171A1D" Offset="0.44" />
                    <GradientStop Color="#141719" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Image Source="/Assets/Images/form-one.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="-18,-22,0,0"
                   Width="390"
                   Opacity="0.12" />

            <Image Source="/Assets/Images/form-two.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-10,-12"
                   Width="330"
                   Opacity="0.13" />

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,28,30,0"
                    Background="#1D2124"
                    BorderBrush="#30363B"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="14,6">
                <TextBlock Text="v. 2.0.0"
                           FontSize="13"
                           FontWeight="Bold"
                           FontFamily="Arial"
                           Foreground="#FFB1B1" />
            </Border>

            <Grid Margin="78">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="176"
                                Height="176"
                                CornerRadius="42"
                                Background="#1D2124"
                                BorderBrush="#30363B"
                                BorderThickness="1"
                                Margin="0,0,34,0">
                            <Border Background="#2A2022"
                                    BorderBrush="#663131"
                                    BorderThickness="1"
                                    CornerRadius="36"
                                    Margin="16">
                                <Image RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="/Assets/Images/logo-nessstudio.png"
                                       Width="112"
                                       Height="112"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                        </Border>

                        <StackPanel Width="510"
                                    VerticalAlignment="Center">
                            <TextBlock Text="NESS STUDIO"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       FontFamily="Arial"
                                       Foreground="#E74C3C"
                                       LineHeight="58" />

                            <TextBlock Text="Capture everything in high quality."
                                       FontSize="24"
                                       FontWeight="Medium"
                                       FontFamily="Arial"
                                       Foreground="#CCD5D7"
                                       Margin="2,10,0,0" />

                            <TextBlock Text="Screen, webcam, microphone, system audio and export workflow built into one focused desktop studio."
                                       FontSize="14"
                                       FontWeight="Regular"
                                       FontFamily="Arial"
                                       Foreground="#708089"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Margin="3,16,24,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#1D2124"
                        BorderBrush="#30363B"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22"
                        Margin="40,0,40,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Loading..."
                                       FontSize="16"
                                       FontWeight="Bold"
                                       FontFamily="Arial"
                                       Foreground="#CCD5D7"
                                       HorizontalAlignment="Left" />

                            <TextBlock Text="Preparing your workspace"
                                       FontSize="13"
                                       FontWeight="Regular"
                                       FontFamily="Arial"
                                       Foreground="#708089"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Grid.Row="2"
                                     IsIndeterminate="True"
                                     Height="6"
                                     Margin="0,12,0,0"
                                     Foreground="#E74C3C"
                                     BorderBrush="Transparent"
                                     Background="#FF5384B5"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>