<Window x:Class="NessStudio.View.HomeScreen.HomeScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NessStudio.View.HomeScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
        mc:Ignorable="d"
        WindowStyle="none"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="true"
        ResizeMode="CanResize"
        Background="{x:Null}"
        Title="HomeScreenWindow"
        Height="768"
        Width="1080"
        MinHeight="600"
        MinWidth="800">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="60"
            ResizeBorderThickness="8"
            CornerRadius="12"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="HomeWindowOuterBorder"
            CornerRadius="16"
            Background="Transparent"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Border x:Name="HomeWindowInnerBorder"
                Margin="1"
                CornerRadius="15"
                Background="#171A1D"
                SnapsToDevicePixels="True"
                ClipToBounds="True">
            <Grid x:Name="HomeWindowClipGrid"
                  ClipToBounds="True">
                <Grid.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="{Binding ActualWidth, ElementName=HomeWindowClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=HomeWindowClipGrid}"
                                    CornerRadius="15"
                                    Background="Black" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#202427"
                        BorderBrush="#30363B"
                        BorderThickness="0,0,0,1">
                    <ContentControl Content="{Binding HeaderContent}" />
                </Border>

                <Grid Grid.Row="1"
                      Background="#171A1D">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#141719"
                            BorderBrush="#2A3035"
                            BorderThickness="0,0,1,0">
                        <ContentControl Content="{Binding MenuContent}" />
                    </Border>

                    <Border Grid.Column="1"
                            Background="#171A1D">
                        <Grid>
                            <Grid.Background>
                                <RadialGradientBrush Center="0.1,0.0"
                                                     GradientOrigin="0.1,0.0"
                                                     RadiusX="1.1"
                                                     RadiusY="1.1">
                                    <GradientStop Color="#2A2022" Offset="0" />
                                    <GradientStop Color="#171A1D" Offset="0.42" />
                                    <GradientStop Color="#171A1D" Offset="1" />
                                </RadialGradientBrush>
                            </Grid.Background>

                            <ContentControl Content="{Binding ProjectsContent}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>