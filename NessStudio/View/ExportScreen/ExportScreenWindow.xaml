<Window x:Class="NessStudio.View.ExportScreen.ExportScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{x:Null}"
        AllowsTransparency="true"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="Export Recording"
        Height="780"
        Width="1040">

    <Window.Resources>
        <SolidColorBrush x:Key="ExportComboBackgroundBrush" Color="#15181A" />
        <SolidColorBrush x:Key="ExportComboForegroundBrush" Color="#CCD5D7" />
        <SolidColorBrush x:Key="ExportComboMutedBrush" Color="#708089" />
        <SolidColorBrush x:Key="ExportComboBorderBrush" Color="#343B40" />
        <SolidColorBrush x:Key="ExportComboHoverBrush" Color="#202427" />
        <SolidColorBrush x:Key="ExportComboSelectedBrush" Color="#2A2022" />
        <SolidColorBrush x:Key="ExportComboAccentBrush" Color="#B33333" />

        <Style x:Key="DarkScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Width="8"
                                HorizontalAlignment="Center"
                                Background="#3A4248"
                                CornerRadius="8"
                                Opacity="0.92" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#4B555C" />
                                <Setter TargetName="ThumbBorder" Property="Width" Value="9" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#B33333" />
                                <Setter TargetName="ThumbBorder" Property="Width" Value="9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="Transparent">
                            <Border Width="10"
                                    HorizontalAlignment="Center"
                                    Background="#15181A"
                                    CornerRadius="8"
                                    Opacity="0.95" />

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource DarkScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource DarkScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Margin="0" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DarkVerticalScrollBarStyle}"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkVerticalScrollBarStyle}" />

        <Style x:Key="ExportComboBoxToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleBorder"
                                Background="{StaticResource ExportComboBackgroundBrush}"
                                BorderBrush="{StaticResource ExportComboBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="12,0,4,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />

                                <Path Grid.Column="1"
                                      Width="10"
                                      Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{StaticResource ExportComboForegroundBrush}"
                                      Data="M 0 0 L 10 0 L 5 6 Z" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource ExportComboHoverBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource ExportComboAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource ExportComboAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource ExportComboForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource ExportComboBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ExportComboBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Foreground" Value="{StaticResource ExportComboForegroundBrush}" />
                        <Setter Property="Background" Value="{StaticResource ExportComboBackgroundBrush}" />
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="FontFamily" Value="Arial" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ExportComboHoverBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ExportComboSelectedBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#606A70" />
                                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Style="{StaticResource ExportComboBoxToggleButtonStyle}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource ExportComboBackgroundBrush}"
                                            BorderBrush="{StaticResource ExportComboAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="0"
                                                      Style="{StaticResource DarkScrollViewerStyle}"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="95" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ExportWindowOuterBorder"
            Width="980"
            Height="720"
            CornerRadius="18"
            Background="#B33333"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Border x:Name="ExportWindowInnerBorder"
                Margin="1"
                CornerRadius="17"
                Background="#23272A"
                SnapsToDevicePixels="True"
                ClipToBounds="True">
            <Grid x:Name="ExportWindowClipGrid"
                  ClipToBounds="True">
                <Grid.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="{Binding ActualWidth, ElementName=ExportWindowClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=ExportWindowClipGrid}"
                                    CornerRadius="17"
                                    Background="Black" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="78" />
                </Grid.RowDefinitions>

                <Border x:Name="HeaderDragArea"
                        Grid.Row="0"
                        BorderBrush="#343B40"
                        BorderThickness="0,0,0,1"
                        Padding="24,18"
                        Background="#23272A"
                        MouseLeftButtonDown="HeaderDragArea_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="13" Background="#2F2525" BorderBrush="#663131" BorderThickness="1" Margin="0,0,14,0">
                                <TextBlock Text="↓" Foreground="#FFB1B1" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Export Recording" Foreground="#CCD5D7" FontFamily="Arial" FontSize="23" FontWeight="Bold" />
                                <TextBlock x:Name="ProjectTitleText" Text="Choose how NessStudio should generate the final files using FFmpeg." Foreground="#708089" FontFamily="Arial" FontSize="13" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Width="38" Height="38" Background="Transparent" BorderBrush="Transparent" Padding="0" Cursor="Hand" Click="CloseButton_Click">
                            <TextBlock Text="×" Foreground="White" FontSize="28" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource DarkScrollViewerStyle}">
                    <Grid Margin="24,24,34,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.18*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.82*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Background="#1D2124" BorderBrush="#30363B" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Export Mode" Foreground="#CCD5D7" FontFamily="Arial" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Step 1" Foreground="#708089" FontFamily="Arial" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SingleModeCard" Grid.Column="0" Background="#2A2022" BorderBrush="#B33333" BorderThickness="1" CornerRadius="14" Padding="14" Cursor="Hand" MouseLeftButtonUp="SingleModeCard_MouseLeftButtonUp">
                                            <StackPanel>
                                                <TextBlock Text="Single file" Foreground="#CCD5D7" FontFamily="Arial" FontSize="15" FontWeight="Bold" />
                                                <TextBlock Text="Create one shareable MP4/MKV with selected video and audio sources." TextWrapping="Wrap" Foreground="#708089" FontFamily="Arial" FontSize="13" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="TracksModeCard" Grid.Column="2" Background="#202427" BorderBrush="#343B40" BorderThickness="1" CornerRadius="14" Padding="14" Cursor="Hand" MouseLeftButtonUp="TracksModeCard_MouseLeftButtonUp">
                                            <StackPanel>
                                                <TextBlock Text="Separate tracks" Foreground="#CCD5D7" FontFamily="Arial" FontSize="15" FontWeight="Bold" />
                                                <TextBlock Text="Export synchronized screen, webcam and audio files for editing." TextWrapping="Wrap" Foreground="#708089" FontFamily="Arial" FontSize="13" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Quick Export defaults to Single file. Advanced users can switch to Separate tracks when they want editing flexibility." TextWrapping="Wrap" Foreground="#708089" FontFamily="Arial" FontSize="13" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="SingleOptionsPanel" Background="#1D2124" BorderBrush="#30363B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Single File Configuration" Foreground="#CCD5D7" FontFamily="Arial" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Step 2" Foreground="#708089" FontFamily="Arial" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Video layout" Foreground="#708089" FontFamily="Arial" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="VideoLayoutComboBox" Grid.Column="1" Height="40" Style="{StaticResource ExportComboBoxStyle}" SelectionChanged="ExportOption_Changed">
                                            <ComboBoxItem Content="No video · Audio only" Tag="NoVideo" />
                                            <ComboBoxItem Content="Screen only" Tag="ScreenOnly" />
                                            <ComboBoxItem Content="Screen + Webcam · Picture-in-picture" Tag="ScreenWebcamPictureInPicture" />
                                            <ComboBoxItem Content="Screen + Webcam · Side by side" Tag="ScreenWebcamSideBySide" />
                                            <ComboBoxItem Content="Webcam only" Tag="WebcamOnly" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Audio mix" Foreground="#708089" FontFamily="Arial" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="AudioMixComboBox" Grid.Column="1" Height="40" Style="{StaticResource ExportComboBoxStyle}" SelectionChanged="ExportOption_Changed">
                                            <ComboBoxItem Content="No audio" Tag="NoAudio" />
                                            <ComboBoxItem Content="Microphone only" Tag="MicrophoneOnly" />
                                            <ComboBoxItem Content="System audio only" Tag="SystemAudioOnly" />
                                            <ComboBoxItem Content="Microphone + System audio" Tag="MicrophoneAndSystemAudio" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Container" Foreground="#708089" FontFamily="Arial" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ContainerComboBox" Grid.Column="1" Height="40" Style="{StaticResource ExportComboBoxStyle}" SelectionChanged="ExportOption_Changed">
                                            <ComboBoxItem Content="MP4 · Recommended" Tag="Mp4" />
                                            <ComboBoxItem Content="MKV" Tag="Mkv" />
                                            <ComboBoxItem Content="MP3 · Audio only" Tag="Mp3" />
                                            <ComboBoxItem Content="WAV · Audio only" Tag="Wav" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Quality" Foreground="#708089" FontFamily="Arial" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="QualityComboBox" Grid.Column="1" Height="40" Style="{StaticResource ExportComboBoxStyle}" SelectionChanged="ExportOption_Changed">
                                            <ComboBoxItem Content="Fast · Smaller file" Tag="Fast" />
                                            <ComboBoxItem Content="Balanced · Recommended" Tag="Balanced" />
                                            <ComboBoxItem Content="High quality" Tag="HighQuality" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="TrackOptionsPanel" Background="#1D2124" BorderBrush="#30363B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,16,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Separate Tracks Configuration" Foreground="#CCD5D7" FontFamily="Arial" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Step 2" Foreground="#708089" FontFamily="Arial" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <UniformGrid Columns="2" Rows="2">
                                        <CheckBox x:Name="ExportScreenCheckBox" Content="Export screen.mp4" Foreground="#CCD5D7" FontFamily="Arial" FontSize="13" Margin="0,0,10,10" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed" />
                                        <CheckBox x:Name="ExportWebcamCheckBox" Content="Export webcam.mp4" Foreground="#CCD5D7" FontFamily="Arial" FontSize="13" Margin="0,0,0,10" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed" />
                                        <CheckBox x:Name="ExportAudioMixCheckBox" Content="Export audio_mix.wav" Foreground="#CCD5D7" FontFamily="Arial" FontSize="13" Margin="0,0,10,0" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed" />
                                        <TextBlock Text="Raw tracks stay untouched" Foreground="#708089" FontFamily="Arial" FontSize="13" VerticalAlignment="Center" />
                                    </UniformGrid>

                                    <TextBlock Text="This mode is intended for editors. Files are copied/transcoded into a clean export folder and kept synchronized using the manifest metadata." TextWrapping="Wrap" Foreground="#708089" FontFamily="Arial" FontSize="13" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1D2124" BorderBrush="#30363B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Output" Foreground="#CCD5D7" FontFamily="Arial" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputPathTextBox" Grid.Column="0" Height="38" Foreground="#CCD5D7" Background="#15181A" BorderBrush="#343B40" Padding="10,0" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="2" Content="Browse" Height="38" Background="#202427" BorderBrush="#343B40" Foreground="White" Click="BrowseButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Background="#1D2124" BorderBrush="#30363B" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Detected Tracks" Foreground="#CCD5D7" FontFamily="Arial" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="From Folder" Foreground="#708089" FontFamily="Arial" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel x:Name="TrackListPanel" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1D2124" BorderBrush="#30363B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Export Summary" Foreground="#CCD5D7" FontFamily="Arial" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Preview" Foreground="#708089" FontFamily="Arial" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Background="#15181A" BorderBrush="#343B40" BorderThickness="1" CornerRadius="14" Padding="14">
                                        <TextBlock x:Name="SummaryTextBlock" TextWrapping="Wrap" Foreground="#708089" FontFamily="Arial" FontSize="13" LineHeight="21" />
                                    </Border>

                                    <ProgressBar x:Name="ExportProgressBar" Height="9" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                                    <TextBlock x:Name="ExportStatusTextBlock" Text="Ready." TextWrapping="Wrap" Foreground="#708089" FontFamily="Arial" FontSize="12" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#343B40" BorderThickness="0,1,0,0" Background="#202427" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ready to export." Foreground="#708089" FontFamily="Arial" FontSize="12" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="CancelButton" Content="Cancel" Height="40" Padding="18,0" Background="Transparent" BorderBrush="#343B40" Foreground="White" Margin="0,0,10,0" Click="CancelButton_Click" />
                            <Button x:Name="StartExportButton" Content="Start Export" Height="40" Padding="20,0" Background="#FF3131" BorderBrush="Transparent" Foreground="White" FontWeight="Bold" Click="StartExportButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>