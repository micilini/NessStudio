<Window x:Class="NessStudio.View.DrawAreaScreen.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            IsHitTestVisible="False">

        <Rectangle x:Name="TopShade"
                   Fill="#33000000" />

        <Rectangle x:Name="BottomShade"
                   Fill="#33000000" />

        <Rectangle x:Name="LeftShade"
                   Fill="#33000000" />

        <Rectangle x:Name="RightShade"
                   Fill="#33000000" />

        <Rectangle x:Name="CropBorder"
                   Fill="Transparent"
                   Stroke="#FFFF6A00"
                   StrokeThickness="4"
                   StrokeDashArray="8,4" />

        <Border x:Name="CaptureBadge"
                Background="#CC000000"
                CornerRadius="8"
                Padding="10,6"
                IsHitTestVisible="False">
            <TextBlock Text="Recording Area"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>