function(nss_materialize_dependencies)
  find_package(Git REQUIRED)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/deps/dependencies.lock.json" lock)
  string(JSON revision GET "${lock}" NessMuxer revision)
  string(JSON expected GET "${lock}" NessMuxer sha256)
  set(bundle "${CMAKE_CURRENT_SOURCE_DIR}/deps/NessMuxer.source.bundle")
  file(SHA256 "${bundle}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Pinned NessMuxer source bundle SHA-256 mismatch")
  endif()
  string(JSON json_hash GET "${lock}" json sha256)
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/deps/json/json.hpp" actual_json)
  if(NOT actual_json STREQUAL json_hash)
    message(FATAL_ERROR "Pinned JSON header SHA-256 mismatch")
  endif()
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/../.out/locks")
  file(LOCK "${CMAKE_CURRENT_SOURCE_DIR}/../.out/locks/dependencies.lock" GUARD FUNCTION TIMEOUT 180)
  set(reproducible true)
  if(NOT NESSMUXER_SOURCE_DIR)
    set(NESSMUXER_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/deps/NessMuxer")
    if(NOT EXISTS "${NESSMUXER_SOURCE_DIR}/.git")
      if(EXISTS "${NESSMUXER_SOURCE_DIR}")
        # A normal Git clone can leave an empty directory for an uninitialized
        # gitlink. Git clone accepts that directory; never replace real content.
        file(GLOB existing_contents LIST_DIRECTORIES true "${NESSMUXER_SOURCE_DIR}/*" "${NESSMUXER_SOURCE_DIR}/.*")
        list(FILTER existing_contents EXCLUDE REGEX "/\\.\\.?$")
        if(existing_contents)
          message(FATAL_ERROR "NessMuxer materialization path contains files without Git metadata; preserve/inspect it before retrying")
        endif()
      endif()
      execute_process(COMMAND "${GIT_EXECUTABLE}" clone --no-checkout "${bundle}" "${NESSMUXER_SOURCE_DIR}" RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot materialize the pinned NessMuxer source bundle")
      endif()
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${NESSMUXER_SOURCE_DIR}" checkout --detach "${revision}" RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot checkout the pinned NessMuxer revision")
      endif()
    endif()
  else()
    set(reproducible false)
    message(WARNING "NESSMUXER_SOURCE_DIR override: this build is not a release-reproducible dependency checkout")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${NESSMUXER_SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${NESSMUXER_SOURCE_DIR}" status --porcelain=v1 OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(reproducible AND (NOT head STREQUAL revision OR NOT dirty STREQUAL ""))
    message(FATAL_ERROR "Pinned NessMuxer checkout differs from its lock or contains local changes; no automatic overwrite performed")
  endif()
  set(NESSMUXER_SOURCE_DIR "${NESSMUXER_SOURCE_DIR}" PARENT_SCOPE)
  set(NSS_NESSMUXER_REVISION "${head}" PARENT_SCOPE)
  set(NSS_REPRODUCIBLE "${reproducible}" PARENT_SCOPE)
endfunction()

function(nss_materialize_encoder_dependencies)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/deps/dependencies.lock.json" lock)
  file(READ "${NESSMUXER_SOURCE_DIR}/native-backends.lock.json" backend_lock)
  foreach(sdk IN ITEMS nvenc amf)
    string(JSON count LENGTH "${backend_lock}" ${sdk} files)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON relative MEMBER "${backend_lock}" ${sdk} files ${index})
      string(JSON expected GET "${backend_lock}" ${sdk} files "${relative}")
      file(SHA256 "${NESSMUXER_SOURCE_DIR}/${relative}" actual)
      if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Pinned ${sdk} API header/notice SHA-256 mismatch: ${relative}")
      endif()
    endforeach()
  endforeach()
  set(NESS_NVENC_V2_INCLUDE_DIR "${NESSMUXER_SOURCE_DIR}/third_party/nv-codec-headers/include" CACHE PATH "Pinned NVENC headers" FORCE)
  set(NESS_AMF_V2_INCLUDE_DIR "${NESSMUXER_SOURCE_DIR}/third_party/amf/include" CACHE PATH "Pinned AMF headers" FORCE)
  string(JSON archive GET "${lock}" libvpl archive)
  string(JSON expected GET "${lock}" libvpl sha256)
  set(input "${CMAKE_CURRENT_SOURCE_DIR}/deps/${archive}")
  file(SHA256 "${input}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Pinned Intel VPL source archive SHA-256 mismatch")
  endif()
  # This is a generated build dependency directory. Re-extracting the exact
  # archive restores its contents without trusting an edited generated SDK.
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/vendor")
  file(ARCHIVE_EXTRACT INPUT "${input}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/vendor")
  set(NESS_VPL_SOURCE_DIR "${CMAKE_CURRENT_BINARY_DIR}/vendor/libvpl-2.17.0" CACHE PATH "Pinned VPL source" FORCE)
  foreach(field IN ITEMS runtime sourceArchive)
    string(JSON relative GET "${lock}" x264 ${field})
    if(field STREQUAL "runtime")
      string(JSON expected GET "${lock}" x264 runtimeSha256)
      set(NSS_X264_RUNTIME "${CMAKE_CURRENT_SOURCE_DIR}/deps/${relative}" PARENT_SCOPE)
    else()
      string(JSON expected GET "${lock}" x264 sourceSha256)
    endif()
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/deps/${relative}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Pinned x264 ${field} SHA-256 mismatch")
    endif()
  endforeach()
  foreach(header IN ITEMS x264.h x264_config.h)
    string(JSON expected GET "${lock}" x264 headers ${header})
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/deps/x264-abi164/include/${header}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Pinned x264 header ${header} SHA-256 mismatch")
    endif()
  endforeach()
  set(NESS_X264_V2_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/deps/x264-abi164/include" CACHE PATH "Pinned x264 headers" FORCE)
endfunction()
