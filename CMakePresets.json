{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v145",
      "binaryDir": "${sourceDir}/.out/native/windows-x64",
      "cacheVariables": { "CMAKE_SYSTEM_VERSION": "10.0.26100.0", "BUILD_TESTING": "ON" }
    },
    {
      "name": "windows-x64-asan",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/.out/native/windows-x64-asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "/fsanitize=address",
        "CMAKE_CXX_FLAGS": "/fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x64-asan", "configurePreset": "windows-x64-asan", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-asan", "configurePreset": "windows-x64-asan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
